APP_NAME="Afya HMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Nairobi
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_KE

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# Database (primary)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=afya
DB_USERNAME=afya
DB_PASSWORD=afya

# Read replicas (Phase 4 — fall back to primary if unset)
DB_READ_HOST=
DB_READ_PORT=3306

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

# Cache / Session / Queue
CACHE_STORE=redis
CACHE_PREFIX=afya_cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

# Broadcasting
BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=log

# Mail (dev: Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@afya.local"
MAIL_FROM_NAME="${APP_NAME}"

# Filesystems
FILESYSTEM_DISK=local
FILESYSTEM_CLOUD=local
STORAGE_DEFAULT_DRIVER=local
STORAGE_CLINICAL_DISK=clinical
STORAGE_SIGNED_URL_TTL=15

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080,127.0.0.1:5173,127.0.0.1:8080
SANCTUM_GUARD=web
SESSION_SECURE_COOKIE=false
SANCTUM_TOKEN_PREFIX=

# Security
BCRYPT_ROUNDS=12
SESSION_IDLE_TIMEOUT=1800
PASSWORD_EXPIRY_DAYS=90
MFA_ISSUER="Afya HMS"

# Notifications
NOTIFICATION_SMS_DRIVER=africastalking
NOTIFICATION_EMAIL_DRIVER=mailgun
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=AFYA
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# M-Pesa Daraja (sandbox defaults)
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_STK_CALLBACK_URL=https://example.com/api/v1/webhooks/mpesa/stk-callback
MPESA_B2C_CALLBACK_URL=https://example.com/api/v1/webhooks/mpesa/b2c-callback
MPESA_C2B_VALIDATE_URL=https://example.com/api/v1/webhooks/mpesa/c2b-validate
MPESA_C2B_CONFIRM_URL=https://example.com/api/v1/webhooks/mpesa/c2b-confirm

# SHA (Social Health Authority)
SHA_ENV=sandbox
SHA_BASE_URL=
SHA_CLIENT_ID=
SHA_CLIENT_SECRET=
SHA_FACILITY_CODE=

# Reverb (WebSockets)
REVERB_APP_ID=afya-reverb
REVERB_APP_KEY=afya-reverb-key
REVERB_APP_SECRET=afya-reverb-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# Frontend (baked into Vite build)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_REVERB_APP_KEY=afya-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=ws

# Observability
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.05

# Feature flags (comma-separated)
FEATURE_FLAGS=

# Horizon
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PREFIX=afya_horizon: