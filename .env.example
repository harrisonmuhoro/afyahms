# Compose-only variables (not for app config — backend/.env and frontend/.env own those)
COMPOSE_PROJECT_NAME=afya-hms

# Host ports (change if you have conflicts)
BACKEND_PORT=8080
FRONTEND_PORT=5173
MYSQL_PORT=3306
REDIS_PORT=6379
MAILPIT_PORT=1025
MAILPIT_UI_PORT=8025

# Image tags (override in CI)
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest